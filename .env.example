# Local development settings. Copy this file to `.env` (same folder) and fill in values.
# The values live in Replit: open the Repl -> Tools -> Secrets.
# `.env` is gitignored - never commit it.

# Postgres connection string (Replit Secret: DATABASE_URL)
DATABASE_URL=

# Lightspeed / Ecwid
VITE_LIGHTSPEED_STORE_ID=142871790
LIGHTSPEED_API_TOKEN=

# Clerk website sign-in. Use the development keys (pk_test_... / sk_test_...);
# production keys do not work on localhost.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
